{
	"name": "time-all-bot",
	"version": "1.0.0",
	"description": "repost times-* channel to \"time-all\"",
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env src/handler.ts",
		"lint": "biome check --write .",
		"format": "biome format .",
		"check": "biome check .",
		"typecheck": "tsc",
		"test": "node --test 'src/**/*.test.ts'",
		"build:lambda": "node scripts/build-lambda.ts",
		"node:major": "node scripts/node-version.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@slack/bolt": "5.1.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@slack/types": "3.3.0",
		"@slack/web-api": "8.3.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	}
}
